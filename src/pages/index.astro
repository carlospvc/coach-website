---
// Jasmine Truong — Executive Leadership Coach Homepage
// Design: v5-behance (Kasia Siwosz / cosmopolitan B&W aesthetic)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Jasmine Truong — Executive Leadership Coach. PhD, CPCC, ACC. Zürich · Worldwide." />
  <title>Jasmine Truong — Executive Leadership Coach</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" />
  <link rel="preload" as="image" href="/images/jasmine-serious.jpg" />
  <link rel="preload" as="image" href="/images/jasmine-looking-up.jpg" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <style>
    /* ── Design tokens ─────────────────────────────────────── */
    :root {
      --ink:       #191917;
      --paper:     #ffffff;
      --soft:      #f3f3f3;
      --mute:      #8a8a86;
      --mute-dark: #6b6b67;
      --rule:      rgba(25,25,23,.12);
      --rule-dark: rgba(255,255,255,.14);
    }

    /* ── Reset & base ──────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Manrope", "Outfit", system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      font-weight: 400;
    }
    a { color: inherit; text-decoration: none; }
    img { display: block; }

    /* ── Layout ────────────────────────────────────────────── */
    .container { max-width: 1320px; margin: 0 auto; padding: 0 48px; }
    section { padding: 140px 0; }

    /* ── Micro / utilities ─────────────────────────────────── */
    .micro {
      font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--mute); font-weight: 500;
    }

    /* ── NAV (sticky — visible after hero) ────────────────── */
    .nav {
      position: sticky; top: 0; z-index: 30;
      background: rgba(25,25,23,.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--rule-dark);
      color: var(--paper);
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .nav.visible { opacity: 1; pointer-events: auto; }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 48px; max-width: 1500px; margin: 0 auto;
    }
    .brand { font-weight: 800; font-size: 17px; letter-spacing: -.01em; }
    .nav-links { display: flex; gap: 32px; }
    .nav-links a { font-size: 13px; color: rgba(255,255,255,.65); transition: color .15s; }
    .nav-links a:hover { color: var(--paper); }
    .nav-cta { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; cursor: pointer; }
    .nav-cta .pill {
      padding: 8px 14px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 999px; transition: all .15s;
    }
    .nav-cta:hover .pill { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* ── HERO ──────────────────────────────────────────────── */
    .hero {
      position: relative; background: var(--ink); color: var(--paper);
      overflow: hidden; isolation: isolate;
      aspect-ratio: 1320 / 760; min-height: 600px;
    }
    /* Full-bleed photo */
    .hero-photo {
      position: absolute; inset: 0; overflow: hidden;
    }
    .hero-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: 50% 6%;
      filter: grayscale(1) contrast(1.06) brightness(0.6);
    }
    /* Bottom gradient */
    .hero-grad {
      position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(0,0,0,.25) 0%,
        rgba(0,0,0,0)   30%,
        rgba(0,0,0,0)   45%,
        rgba(0,0,0,.82) 100%
      );
    }
    /* Film grain */
    .hero::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      opacity: .035; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }
    /* Hero nav (absolute, inside hero) */
    .hero-nav {
      position: absolute; top: 0; left: 0; right: 0; z-index: 30;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 36px;
      border-bottom: 1px solid var(--rule-dark);
      background: rgba(25,25,23,.6);
      backdrop-filter: blur(8px);
      color: var(--paper);
    }
    .hero-nav .brand {
      font-weight: 800; font-size: 13px; letter-spacing: .04em; line-height: 1.2;
    }
    .hero-nav ul {
      list-style: none; display: flex; gap: 26px;
    }
    .hero-nav ul a {
      color: rgba(255,255,255,.65); font-size: 12px;
      text-decoration: none; transition: color .15s;
    }
    .hero-nav ul a:hover { color: var(--paper); }
    .hero-nav .cta {
      padding: 7px 14px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 999px; font-size: 12px; color: var(--paper);
      text-decoration: none; transition: background .15s, color .15s;
    }
    .hero-nav .cta:hover { background: var(--paper); color: var(--ink); }
    /* Name + tagline stack at bottom */
    .hero-stack {
      position: absolute; left: 0; right: 0; bottom: 70px;
      text-align: center; padding: 0 24px; z-index: 2;
    }
    .hero-name {
      font-weight: 800; font-size: 128px;
      letter-spacing: -.05em; line-height: .9;
      color: var(--paper); mix-blend-mode: difference;
      margin: 0 0 26px;
    }
    .hero-tagline {
      font-weight: 300; font-size: 30px; line-height: 1.25;
      letter-spacing: -.012em; color: rgba(255,255,255,.92);
      padding: 0 80px; margin: 0;
    }
    .hero-tagline strong { font-weight: 700; color: var(--paper); }

    @media (max-width: 900px) {
      .hero-nav ul { display: none; }
      .hero-stack { bottom: 48px; }
      .hero-name { font-size: clamp(56px, 12vw, 96px); margin-bottom: 18px; }
      .hero-tagline { font-size: clamp(16px, 3.2vw, 22px); padding: 0 24px; }
    }

    /* ── PULL QUOTE ────────────────────────────────────────── */
    .pull { background: var(--ink); color: var(--paper); }
    .pull-inner { max-width: 1000px; text-align: center; margin: 0 auto; }
    .pull .qm {
      font-size: 80px; font-weight: 600; line-height: 0;
      color: var(--paper); display: block; margin-bottom: 56px;
    }
    .pull blockquote {
      font-weight: 400; font-size: 56px; letter-spacing: -.02em;
      line-height: 1.12; margin: 0 0 40px;
    }
    .pull blockquote strong { font-weight: 800; }
    .pull .attr { font-size: 13px; color: rgba(255,255,255,.55); letter-spacing: .04em; }

    /* ── WHAT I DO + QUESTIONS ─────────────────────────────── */
    .what-questions { background: var(--paper); }
    .what-block { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .what-block .left .label {
      font-weight: 800; font-size: clamp(56px, 6vw, 88px);
      line-height: .96; letter-spacing: -.035em; text-transform: uppercase; margin: 0 0 28px;
    }
    .what-block .left p { font-size: 16px; color: var(--mute-dark); line-height: 1.6; max-width: 460px; }
    .what-block .left p strong { color: var(--ink); font-weight: 700; }
    .what-block .right h2 {
      font-weight: 400; font-size: 38px; line-height: 1.2;
      letter-spacing: -.015em; margin: 0 0 24px;
    }
    .what-block .right h2 strong { font-weight: 800; }
    .what-block .right p { font-size: 15.5px; line-height: 1.65; color: var(--mute-dark); max-width: 560px; }

    .questions-merged {
      margin-top: 120px; padding-top: 80px; border-top: 1px solid var(--rule);
    }
    .q-head {
      display: flex; justify-content: space-between; align-items: end;
      margin-bottom: 64px; gap: 40px;
    }
    .q-head h3 {
      font-weight: 300; font-size: 36px; letter-spacing: -.015em;
      line-height: 1.15; max-width: 580px;
    }
    .pager { display: flex; gap: 14px; align-items: center; }
    .pager .count { font-size: 14px; color: var(--mute-dark); letter-spacing: .04em; }
    .pager .progress { width: 100px; height: 1px; background: var(--rule); overflow: hidden; }
    .pager .progress span {
      display: block; height: 100%; background: var(--ink);
      transition: transform .6s cubic-bezier(.4,0,.2,1);
      transform-origin: left;
    }
    .q-stage { position: relative; min-height: 360px; padding-left: 56px; max-width: 1100px; }
    .q-bullet {
      position: absolute; left: 0; top: 32px;
      width: 14px; height: 14px; border-radius: 50%; background: var(--ink);
    }
    .q-text {
      font-weight: 800; font-size: clamp(56px, 7.5vw, 108px);
      line-height: .98; letter-spacing: -.035em; text-transform: uppercase;
      margin: 0 0 32px; transition: opacity .45s, transform .45s;
    }
    .q-sub {
      font-size: 17px; color: var(--mute-dark); max-width: 540px;
      line-height: 1.55; transition: opacity .45s .1s, transform .45s .1s;
    }
    .q-fade-out .q-text, .q-fade-out .q-sub { opacity: 0; transform: translateY(16px); }
    .q-fade-in .q-text, .q-fade-in .q-sub { opacity: 1; transform: translateY(0); }
    .q-cta { margin-top: 64px; padding-left: 56px; display: flex; align-items: center; gap: 20px; }
    .q-cta .btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 24px; background: var(--ink); color: var(--paper);
      font-size: 14px; font-family: inherit; letter-spacing: .02em;
      border: 0; cursor: pointer; transition: background .15s;
    }
    .q-cta .btn:hover { background: #2a2a26; }
    .q-cta .note { color: var(--mute-dark); font-size: 14px; }

    /* ── SERVICES ──────────────────────────────────────────── */
    .services { background: var(--ink); color: var(--paper); }
    .services-head {
      display: grid; grid-template-columns: 100px 1fr;
      gap: 48px; margin-bottom: 64px; align-items: end;
    }
    .services-head .ix {
      font-size: 64px; font-weight: 300; line-height: 1;
      letter-spacing: -.025em; color: rgba(255,255,255,.4);
    }
    .services-head h2 {
      font-weight: 400; font-size: 56px; line-height: 1;
      letter-spacing: -.025em; max-width: 800px;
    }
    .services-head h2 strong { font-weight: 800; }
    .services-head .lead {
      font-size: 16px; color: rgba(255,255,255,.6);
      max-width: 480px; margin: 24px 0 0; line-height: 1.55;
    }
    .service {
      display: grid; grid-template-columns: 100px 1.2fr 1.8fr 120px;
      gap: 48px; padding: 40px 0;
      border-top: 1px solid var(--rule-dark);
      align-items: start; transition: padding-left .25s; cursor: pointer;
    }
    .service:hover { padding-left: 16px; background: rgba(255,255,255,.02); }
    .service:last-child { border-bottom: 1px solid var(--rule-dark); }
    .service .sno { font-size: 22px; font-weight: 800; letter-spacing: -.01em; }
    .service .stitle { font-size: 28px; font-weight: 600; line-height: 1.1; letter-spacing: -.015em; }
    .service .smeta {
      font-size: 12px; color: rgba(255,255,255,.5); margin-top: 10px;
      letter-spacing: .06em; text-transform: uppercase;
    }
    .service p { font-size: 15.5px; line-height: 1.6; color: rgba(255,255,255,.75); margin: 0 0 16px; }
    .service ul { list-style: none; columns: 2; column-gap: 24px; }
    .service ul li {
      padding: 6px 0; font-size: 13px; color: rgba(255,255,255,.65);
      display: flex; gap: 10px; align-items: center;
    }
    .service ul li::before { content: "—"; color: rgba(255,255,255,.4); }
    .service .arrow {
      justify-self: end; align-self: center; font-size: 20px;
      width: 52px; height: 52px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      transition: all .2s;
    }
    .service:hover .arrow { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* ── TESTIMONIALS ──────────────────────────────────────── */
    .testimonials { background: var(--soft); }
    .testimonials-head { margin-bottom: 64px; max-width: 880px; }
    .testimonials-head h2 {
      font-weight: 400; font-size: 48px; line-height: 1.1;
      letter-spacing: -.02em; margin: 16px 0 0;
    }
    .testimonials-head h2 strong { font-weight: 800; }
    .testi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .testi {
      padding: 40px; border: 1px solid var(--rule);
      margin: -1px 0 0 -1px; background: var(--paper);
      display: flex; flex-direction: column; gap: 24px;
    }
    .testi .qmark { font-size: 36px; font-weight: 800; line-height: 0; color: var(--ink); margin-top: 16px; }
    .testi blockquote {
      font-size: 22px; line-height: 1.35; letter-spacing: -.012em; font-weight: 400;
    }
    .testi .author {
      display: flex; align-items: center; gap: 14px;
      padding-top: 24px; border-top: 1px solid var(--rule); margin-top: auto;
    }
    .testi .avatar {
      width: 40px; height: 40px; border-radius: 50%;
      background: var(--ink); color: var(--paper);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 13px; letter-spacing: .02em; flex-shrink: 0;
    }
    .testi .author .name strong { display: block; font-size: 14px; font-weight: 600; }
    .testi .author .name span { font-size: 13px; color: var(--mute-dark); }

    /* ── WHO AM I ──────────────────────────────────────────── */
    .aboutme { background: var(--paper); }
    .aboutme-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 80px; align-items: center; }
    .aboutme-photo { aspect-ratio: 4/5; overflow: hidden; background: var(--soft); }
    .aboutme-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
      filter: grayscale(1) contrast(1.02);
    }
    .aboutme h2 {
      font-weight: 800; font-size: clamp(80px, 9vw, 132px);
      line-height: .92; letter-spacing: -.04em;
      margin: 24px 0 32px; text-transform: uppercase;
    }
    .aboutme p { font-size: 17px; line-height: 1.65; margin: 0 0 18px; max-width: 520px; }
    .aboutme p strong { font-weight: 700; }
    .aboutme .mute { color: var(--mute-dark); }
    .aboutme .lesson {
      margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--rule);
      display: flex; gap: 14px; align-items: baseline;
    }
    .aboutme .lesson .micro { color: var(--mute); flex-shrink: 0; }
    .aboutme .lesson p { font-size: 18px; max-width: none; font-weight: 500; margin: 0; }
    .creds-row {
      display: flex; gap: 28px; margin-top: 32px;
      padding-top: 24px; border-top: 1px solid var(--rule);
    }
    .creds-row div .lbl {
      font-size: 11px; color: var(--mute); letter-spacing: .12em;
      text-transform: uppercase; margin-bottom: 6px; font-weight: 500;
    }
    .creds-row div .val { font-size: 15px; font-weight: 700; }

    /* ── CONTACT ───────────────────────────────────────────── */
    .contact { background: var(--ink); color: var(--paper); padding: 140px 0 0; }
    .contact .head h2 {
      font-weight: 400; font-size: 56px; line-height: 1.05;
      letter-spacing: -.02em; margin: 16px 0 64px; max-width: 720px;
    }
    .contact .head h2 strong { font-weight: 800; }
    .contact-grid {
      display: grid; grid-template-columns: 1.1fr 1.4fr;
      gap: 80px; align-items: start; padding-bottom: 100px;
    }
    .contact-left p {
      font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.75);
      max-width: 380px; margin: 0 0 32px;
    }
    .contact-creds {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 24px 32px; padding-top: 28px;
      border-top: 1px solid var(--rule-dark); max-width: 400px;
    }
    .contact-creds div .lbl {
      font-size: 11px; color: rgba(255,255,255,.5); letter-spacing: .12em;
      text-transform: uppercase; margin-bottom: 6px; font-weight: 500;
    }
    .contact-creds div .val { font-size: 14px; font-weight: 700; }
    .form { display: flex; flex-direction: column; gap: 22px; }
    .form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .field { display: flex; flex-direction: column; gap: 8px; }
    .field label {
      font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.5); font-weight: 500;
    }
    .field input, .field select, .field textarea {
      background: transparent; border: 0;
      border-bottom: 1px solid rgba(255,255,255,.25);
      padding: 8px 0 12px; color: var(--paper);
      font-family: inherit; font-size: 17px; outline: none;
      transition: border-color .2s;
    }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--paper); }
    .field textarea { resize: vertical; min-height: 60px; }
    .field select option { background: var(--ink); color: var(--paper); }
    .submit {
      background: var(--paper); color: var(--ink); border: 0;
      padding: 18px 28px; font-weight: 700; font-size: 13px;
      letter-spacing: .1em; text-transform: uppercase; font-family: inherit;
      cursor: pointer; transition: all .15s; align-self: flex-start; margin-top: 12px;
    }
    .submit:hover { background: var(--soft); }
    .submitted-msg { padding: 40px 0; }
    .submitted-msg .recv { font-size: 13px; color: rgba(255,255,255,.5); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 16px; }
    .submitted-msg .thanks { font-weight: 800; font-size: 32px; letter-spacing: -.01em; text-transform: uppercase; line-height: 1.2; }

    /* ── FOOTER ────────────────────────────────────────────── */
    .foot-mark { background: var(--ink); color: var(--paper); padding: 64px 48px 24px; }
    .foot-mark .big {
      font-weight: 800; font-size: clamp(32px, 5.5vw, 80px);
      letter-spacing: -.045em; line-height: .9; white-space: nowrap;
    }
    .foot-meta {
      background: var(--ink); color: var(--paper);
      padding: 24px 48px 32px;
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12px; color: rgba(255,255,255,.5);
      border-top: 1px solid var(--rule-dark); margin: 24px 48px 0;
    }

    /* ── RESPONSIVE ────────────────────────────────────────── */
    @media (max-width: 1000px) {
      .container { padding: 0 24px; }
      .nav-inner { padding: 16px 24px; }
      .nav-links { display: none; }
      .hero-photo { width: 260px; left: 50%; }
      .hero-wordmark { font-size: 60px; }
      section { padding: 80px 0; }
      .contact { padding-top: 80px; }
      .what-block { grid-template-columns: 1fr; gap: 32px; }
      .services-head { grid-template-columns: 1fr; gap: 16px; }
      .aboutme-grid { grid-template-columns: 1fr; gap: 32px; }
      .contact-grid { grid-template-columns: 1fr; gap: 32px; }
      .q-head { flex-direction: column; align-items: flex-start; gap: 16px; }
      .q-stage { padding-left: 28px; }
      .q-cta { padding-left: 28px; flex-direction: column; align-items: flex-start; }
      .service { grid-template-columns: 60px 1fr; gap: 16px; padding: 28px 0; }
      .service .arrow { display: none; }
      .service ul { columns: 1; }
      .testi-grid { grid-template-columns: 1fr; }
      .form .row { grid-template-columns: 1fr; }
      .pull blockquote { font-size: 36px; }
      .foot-mark { padding: 48px 24px 16px; }
      .foot-meta { margin: 16px 24px 0; padding: 16px 0 24px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <span class="brand">JASMINE TRUONG</span>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#questions">Is this for you?</a>
        <a href="#services">Coaching</a>
        <a href="#testimonials">Testimonials</a>
        <a href="#aboutme">Who am I</a>
      </div>
      <a href="#contact" class="nav-cta">
        <span class="pill">Book a free call →</span>
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="about">
    <div class="hero-photo">
      <img src="/images/jasmine-serious.jpg" alt="Jasmine Truong" />
    </div>
    <div class="hero-grad"></div>

    <nav class="hero-nav">
      <div class="brand">JASMINE<br>TRUONG</div>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#questions">Is this for you?</a></li>
        <li><a href="#services">Coaching</a></li>
        <li><a href="#testimonials">Testimonials</a></li>
        <li><a href="#aboutme">Who am I</a></li>
      </ul>
      <a class="cta" href="#contact">Book a free call →</a>
    </nav>

    <div class="hero-stack">
      <h1 class="hero-name">Jasmine Truong</h1>
      <p class="hero-tagline">
        Leadership <strong>begins with presence</strong>, and becomes <strong>real in practice</strong>.
      </p>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="pull">
    <div class="container">
      <div class="pull-inner">
        <span class="qm">"</span>
        <blockquote>
          Leadership <strong>begins with presence</strong>, and becomes <strong>real in practice.</strong>
        </blockquote>
        <p class="attr">— A working principle</p>
      </div>
    </div>
  </section>

  <!-- WHAT I DO + QUESTIONS -->
  <section class="what-questions" id="questions">
    <div class="container">

      <!-- What I Do -->
      <div class="what-block">
        <div class="left">
