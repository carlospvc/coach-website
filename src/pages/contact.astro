---
import Layout from '../layouts/Layout.astro';
import siteData from '../content/site/main.json';

const { contact } = siteData;
---

<Layout title="Contact — Business Coach" description="Book a free discovery call or get in touch.">

  <section class="max-w-3xl mx-auto px-6 pt-20 pb-24">

    <div class="mb-14">
      <h1 class="text-4xl font-bold text-neutral-900 mb-4">Let's talk</h1>
      <p class="text-lg text-neutral-500">
        The first conversation is always free. No pitch, no pressure — just an honest exchange to see if we're the right fit.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-10">

      <div class="space-y-6">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-neutral-400 mb-1">Email</p>
          <a href={`mailto:${contact.email}`} class="text-neutral-800 hover:text-amber-700 font-medium transition-colors">
            {contact.email}
          </a>
        </div>
        {contact.phone && (
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-neutral-400 mb-1">Phone</p>
            <a href={`tel:${contact.phone}`} class="text-neutral-800 hover:text-amber-700 font-medium transition-colors">
              {contact.phone}
            </a>
          </div>
        )}
        {contact.location && (
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-neutral-400 mb-1">Location</p>
            <p class="text-neutral-800 font-medium">{contact.location}</p>
          </div>
        )}
        {contact.calendly && (
          <div class="pt-4">
            <a
              href={contact.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-6 py-3 rounded-xl font-semibold text-white hover:opacity-90 transition-opacity"
              style="background: var(--color-brand)"
            >
              Book via Calendly →
            </a>
          </div>
        )}
      </div>

      <form name="contact" method="POST" data-netlify="true" class="space-y-5">
        <input type="hidden" name="form-name" value="contact" />
        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1" for="name">Name</label>
          <input id="name" name="name" type="text" required
            class="w-full px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:border-amber-400 transition-colors"
            placeholder="Your name" />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1" for="email">Email</label>
          <input id="email" name="email" type="email" required
            class="w-full px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:border-amber-400 transition-colors"
            placeholder="you@example.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1" for="message">Message</label>
          <textarea id="message" name="message" rows="4" required
            class="w-full px-4 py-2.5 rounded-lg border border-neutral-200 text-sm focus:outline-none focus:border-amber-400 transition-colors resize-none"
            placeholder="Tell me a little about what you're working through…"></textarea>
        </div>
        <button type="submit"
          class="w-full py-3 rounded-xl font-semibold text-white hover:opacity-90 transition-opacity"
          style="background: var(--color-brand)">
          Send message
        </button>
      </form>

    </div>
  </section>
</Layout>
