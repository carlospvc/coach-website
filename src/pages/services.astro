---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services — Business Coach" description="Coaching programmes for leaders, executives, and teams.">

  <section class="max-w-3xl mx-auto px-6 pt-20 pb-24">

    <div class="mb-14">
      <h1 class="text-4xl font-bold text-neutral-900 mb-4">Programmes</h1>
      <p class="text-lg text-neutral-500 max-w-xl">
        Every engagement is built around what you actually need — not a template, not a formula.
      </p>
    </div>

    <div class="space-y-8">
      {services.map((service, i) => (
        <div class="p-8 rounded-2xl border border-neutral-100 bg-white shadow-sm">
          <span class="text-xs font-semibold tracking-widest uppercase text-amber-700 mb-2 block">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="text-xl font-bold text-neutral-900">{service.data.title}</h2>
          <p class="text-amber-700 font-medium mt-1 mb-4">{service.data.tagline}</p>
          <p class="text-neutral-600 leading-relaxed">{service.data.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 bg-neutral-50 border border-neutral-100 rounded-2xl p-8 text-center">
      <h3 class="font-semibold text-neutral-900 mb-2">Not sure which is right for you?</h3>
      <p class="text-neutral-500 text-sm mb-6">
        A free 30-minute discovery call is the best place to start. No pitch, no pressure.
      </p>
      <a href="/contact"
        class="inline-block px-6 py-3 rounded-xl font-semibold text-white hover:opacity-90 transition-opacity"
        style="background: var(--color-brand)">
        Book a discovery call
      </a>
    </div>

  </section>
</Layout>
