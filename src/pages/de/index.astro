---
// Jasmine Truong — Executive Leadership Coach Homepage (German)
import { getCollection } from 'astro:content';
import hero           from '../../content/site/hero.json';
import theHow         from '../../content/site/the-how.json';
import questionsSection from '../../content/site/questions.json';
import testimonialsSection from '../../content/site/testimonials-section.json';
import aboutme_section from '../../content/site/aboutme.json';
import contact_section from '../../content/site/contact.json';
import footerData      from '../../content/site/footer.json';
import accredsSectionData from '../../content/site/accreditations-section.json';
import servicesSection   from '../../content/site/services-section.json';

const accreditations = (await getCollection('accreditations')).sort((a: any, b: any) => a.data.order - b.data.order);

const servicesRaw = await getCollection('services');
const services = servicesRaw
  .sort((a: any, b: any) => (a.data.order ?? 0) - (b.data.order ?? 0));

const testimonialsRaw = await getCollection('testimonials');
const testimonials = testimonialsRaw
  .filter((t: any) => t.data.published === true)
  .sort((a: any, b: any) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Converts markdown bold/italic to HTML. Also strips wrapping <p> tags
// that some markdown editors add around single-line content.
function boldMd(text: string) {
  return (text ?? '')
    .replace(/\*\*(.*?)\*\*/gs, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/gs,   '<em>$1</em>')
    .replace(/^<p>([\s\S]*?)<\/p>$/i, '$1')
    .trim();
}

function bioParagraphs(text: string) {
  return (text ?? '')
    .split(/\n\n+/)
    .filter((p: string) => p.trim())
    .map((p: string) => {
      const inner = p.trim()
        .replace(/\*\*(.*?)\*\*/gs, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/gs, '<em>$1</em>');
      return `<p class="mute">${inner}</p>`;
    })
    .join('');
}

function initials(name: string) {
  return name.split(' ').map((w: string) => w[0]).join('');
}
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Jasmine Truong — Executive Coaching. PhD, CPCC, ACC. Zürich · Weltweit." />
  <title>Jasmine Truong — Executive Coaching</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="https://jtruong.com/de/" />
  <link rel="alternate" hreflang="de" href="https://jtruong.com/de/" />
  <link rel="alternate" hreflang="en" href="https://jtruong.com/" />
  <link rel="alternate" hreflang="x-default" href="https://jtruong.com/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700&family=Archivo+Black&family=Manrope:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" />
  <link rel="preload" as="image" href="/images/jasmine-serious.jpg" />
  <link rel="preload" as="image" href="/images/jasmine-looking-up.jpg" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <style>
    /* ── Design tokens ─────────────────────────────────────── */
    :root {
      --ink:       #191917;
      --paper:     #ffffff;
      --soft:      #f3f3f3;
      --mute:      #8a8a86;
      --mute-dark: #6b6b67;
      --rule:      rgba(25,25,23,.12);
      --rule-dark: rgba(255,255,255,.14);
    }

    /* ── Reset & base ──────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Manrope", "Outfit", system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      font-weight: 400;
    }
    a { color: inherit; text-decoration: none; }
    img { display: block; }

    /* ── Layout ────────────────────────────────────────────── */
    .container { max-width: 1320px; margin: 0 auto; padding: 0 48px; }
    section { padding: 140px 0; }

    /* ── Micro / utilities ─────────────────────────────────── */
    .micro {
      font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--mute); font-weight: 500;
    }

    /* ── NAV (fixed — visible after hero) ─────────────────── */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 30;
      background: rgba(25,25,23,.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--rule-dark);
      color: var(--paper);
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .nav.visible { opacity: 1; pointer-events: auto; }
    .nav-inner {
      display: grid; grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 18px 48px; max-width: 1500px; margin: 0 auto;
    }
    .nav-inner .nav-links { justify-self: center; }
    .nav-inner .nav-cta   { justify-self: end; }
    .nav-links { display: flex; gap: 32px; }
    .nav-links a { font-size: 13px; color: rgba(255,255,255,.65); transition: color .15s; }
    .nav-links a:hover { color: var(--paper); }
    .nav-brand-block { display: flex; flex-direction: column; gap: 3px; text-decoration: none; color: inherit; }
    .nav-brand-name { font-weight: 800; font-size: 12px; letter-spacing: .07em; color: var(--paper); line-height: 1; text-transform: uppercase; white-space: nowrap; }
    .nav-brand-sub { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.42); font-weight: 500; line-height: 1; white-space: nowrap; }
    .nav-cta { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; cursor: pointer; }
    .nav-cta .pill {
      padding: 8px 14px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 999px; transition: all .15s;
    }
    .nav-cta:hover .pill { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* ── HERO ──────────────────────────────────────────────── */
    .hero {
      position: relative; background: var(--ink); color: var(--paper);
      overflow: hidden; isolation: isolate;
      aspect-ratio: 1320 / 760; min-height: 600px;
    }
    /* Full-bleed photo */
    .hero-photo {
      position: absolute; inset: 0; overflow: hidden;
    }
    .hero-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: 50% 6%;
      filter: grayscale(1) contrast(1.06) brightness(1.1);
    }
    /* Bottom gradient */
    .hero-grad {
      position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(0,0,0,.15) 0%,
        rgba(0,0,0,0)   30%,
        rgba(0,0,0,0)   45%,
        rgba(0,0,0,.65) 100%
      );
    }
    /* Film grain */
    .hero::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      opacity: .035; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }
    /* Hero nav (absolute, inside hero) */
    .hero-nav {
      position: absolute; top: 0; left: 0; right: 0; z-index: 30;
      display: grid; grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 18px 36px;
      border-bottom: 1px solid var(--rule-dark);
      background: rgba(25,25,23,.6);
      backdrop-filter: blur(8px);
      color: var(--paper);
    }
    .hero-nav ul { justify-self: center; }
    .hero-nav .cta { justify-self: end; }
    .hero-nav .nav-brand-block { display: flex; }
    .hero-nav ul {
      list-style: none; display: flex; gap: 26px;
    }
    .hero-nav ul a {
      color: rgba(255,255,255,.65); font-size: 12px;
      text-decoration: none; transition: color .15s;
    }
    .hero-nav ul a:hover { color: var(--paper); }
    .hero-nav .cta {
      padding: 7px 14px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 999px; font-size: 12px; color: var(--paper);
      text-decoration: none; transition: background .15s, color .15s;
    }
    .hero-nav .cta:hover { background: var(--paper); color: var(--ink); }
    /* Name + tagline stack at bottom */
    .hero-stack {
      position: absolute; left: 0; right: 0; bottom: 70px;
      text-align: center; padding: 0 24px; z-index: 2;
    }
    .hero-name {
      font-weight: 800; font-size: 128px;
      letter-spacing: -.05em; line-height: .9;
      color: rgba(255,255,255,.75);
      margin: 0 0 26px;
    }
    .hero-tagline {
      font-weight: 300; font-size: 30px; line-height: 1.25;
      letter-spacing: -.012em; color: rgba(255,255,255,.92);
      padding: 0 80px; margin: 0;
    }
    .hero-tagline :global(strong) { font-weight: 700; color: var(--paper); }

    @media (max-width: 900px) {
      .hero-nav ul { display: none; }
      .hero-stack { bottom: 48px; }
      .hero-name { font-size: clamp(56px, 12vw, 96px); margin-bottom: 18px; }
      .hero-tagline { font-size: clamp(16px, 3.2vw, 22px); padding: 0 24px; }
    }

    /* ── PULL QUOTE ────────────────────────────────────────── */
    .pull { background: var(--ink); color: var(--paper); }
    .pull-inner { max-width: 1000px; text-align: center; margin: 0 auto; }
    .pull .qm {
      font-size: 80px; font-weight: 600; line-height: 0;
      color: var(--paper); display: block; margin-bottom: 56px;
    }
    .pull blockquote {
      font-weight: 400; font-size: 56px; letter-spacing: -.02em;
      line-height: 1.12; margin: 0 0 40px;
    }
    .pull blockquote strong { font-weight: 800; }
    .pull .attr { font-size: 13px; color: rgba(255,255,255,.55); letter-spacing: .04em; }

    /* ── WHAT I DO + QUESTIONS ─────────────────────────────── */
    .what-questions { background: var(--paper); }
    .what-block { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .what-block .left .label {
      font-weight: 800; font-size: clamp(45px, 4.8vw, 70px);
      line-height: .96; letter-spacing: -.035em; text-transform: uppercase; margin: 0 0 28px;
    }
    .what-block .left p { font-size: 16px; color: var(--mute-dark); line-height: 1.6; max-width: 460px; }
    .what-block .left p :global(strong) { color: var(--ink); font-weight: 700; }
    .what-block .right h2 {
      font-weight: 400; font-size: 30px; line-height: 1.2;
      letter-spacing: -.015em; margin: 0 0 24px;
    }
    .what-block .right h2 :global(strong) { font-weight: 800; }
    .what-block .right p { font-size: 15.5px; line-height: 1.65; color: var(--mute-dark); max-width: 560px; }

    .questions-merged {
      margin-top: 80px; padding-top: 56px; border-top: 1px solid var(--rule);
    }
    .q-head {
      display: flex; justify-content: space-between; align-items: end;
      margin-bottom: 64px; gap: 40px;
    }
    .q-head h3 {
      font-weight: 300; font-size: 30px; letter-spacing: -.015em;
      line-height: 1.15; max-width: 1100px;
    }
    .pager { display: flex; gap: 14px; align-items: center; }
    .pager .count { font-size: 14px; color: var(--mute-dark); letter-spacing: .04em; }
    .pager .progress { width: 100px; height: 1px; background: var(--rule); overflow: hidden; }
    .pager .progress span {
      display: block; height: 100%; background: var(--ink);
      transition: transform .6s cubic-bezier(.4,0,.2,1);
      transform-origin: left;
    }
    .q-stage {
      position: relative; padding-left: 56px; max-width: 1100px; padding-bottom: 8px;
      height: calc(3 * 0.98 * 70px + 40px);
    }
    .q-bullet {
      position: absolute; left: 0; top: 32px;
      width: 14px; height: 14px; border-radius: 50%; background: var(--ink);
    }
    .q-text {
      font-weight: 800; font-size: clamp(45px, 4.8vw, 70px);
      line-height: .98; letter-spacing: -.035em; text-transform: uppercase;
      margin: 0 0 32px; transition: opacity .45s, transform .45s;
    }
    .q-fade-out .q-text { opacity: 0; transform: translateY(16px); }
    .q-fade-in .q-text { opacity: 1; transform: translateY(0); }

    /* ── SERVICES ──────────────────────────────────────────── */
    .services { background: var(--ink); color: var(--paper); }
    .services-head {
      display: grid; grid-template-columns: 100px 1fr;
      gap: 48px; margin-bottom: 64px; align-items: end;
    }
    .services-head .ix {
      font-size: 64px; font-weight: 300; line-height: 1;
      letter-spacing: -.025em; color: rgba(255,255,255,.4);
    }
    .services-head h2 {
      font-weight: 400; font-size: 56px; line-height: 1;
      letter-spacing: -.025em; max-width: 800px;
    }
    .services-head h2 strong { font-weight: 800; }
    .services-head .lead {
      font-size: 16px; color: rgba(255,255,255,.6);
      max-width: 480px; margin: 24px 0 0; line-height: 1.55;
    }
    .service {
      display: grid; grid-template-columns: 100px 1.2fr 1fr;
      gap: 48px; padding: 40px 0;
      border-top: 1px solid var(--rule-dark);
      align-items: start; transition: padding-left .25s;
    }
    .service:hover { padding-left: 16px; background: rgba(255,255,255,.02); }
    .service:last-child { border-bottom: 1px solid var(--rule-dark); }
    .service .sno { font-size: 22px; font-weight: 800; letter-spacing: -.01em; }
    .service .stitle { font-size: 28px; font-weight: 600; line-height: 1.1; letter-spacing: -.015em; }
    .service .smeta {
      font-size: 12px; color: rgba(255,255,255,.5); margin-top: 10px;
      letter-spacing: .06em; text-transform: uppercase;
    }
    .service p { font-size: 15.5px; line-height: 1.6; color: rgba(255,255,255,.75); margin: 0 0 16px; }
    .service ul { list-style: none; columns: 2; column-gap: 24px; }
    .service ul li {
      padding: 6px 0; font-size: 13px; color: rgba(255,255,255,.65);
      display: flex; gap: 10px; align-items: center;
    }
    .service ul li::before { content: "—"; color: rgba(255,255,255,.4); }
    .service .arrow {
      justify-self: end; align-self: center; font-size: 20px;
      width: 52px; height: 52px; border: 1px solid rgba(255,255,255,.3);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      transition: all .2s;
    }
    .service:hover .arrow { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* ── TESTIMONIALS (rotator) ────────────────────────────── */
    .testimonials { background: var(--soft); padding: 88px 0 96px; }
    .testi-head {
      margin-bottom: 40px; display: flex;
      align-items: baseline; justify-content: space-between; gap: 32px;
    }
    .testi-head h2 {
      font-weight: 400; font-size: 56px; line-height: 1.05;
      letter-spacing: -.025em; margin: 0; max-width: 760px;
    }
    .testi-head h2 :global(strong) { font-weight: 800; }
    .testi-head .ix { font-size: 11px; letter-spacing: .12em; color: var(--mute); font-weight: 500; }
    .testi-rotator {
      display: grid; grid-template-columns: 1fr 240px;
      gap: 64px; align-items: stretch; height: 300px;
    }
    .rstage { position: relative; height: 100%; display: flex; flex-direction: column; min-height: 0; }
    .qmark-big {
      position: absolute; left: -8px; top: -64px;
      font-size: 140px; font-weight: 800; line-height: 1;
      color: rgba(25,25,23,.07); pointer-events: none; user-select: none;
    }
    .quote-wrap { position: relative; flex: 1 1 auto; overflow: hidden; max-width: 860px; min-height: 0; }
    .quote-wrap::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 64px;
      background: linear-gradient(to bottom, rgba(243,243,243,0), var(--soft));
      pointer-events: none;
    }
    .rstage blockquote {
      font-size: 15px; line-height: 1.5; letter-spacing: -.014em;
      font-weight: 400; margin: 0; color: var(--ink);
      transition: opacity .35s ease, transform .35s ease;
    }
    .quote-wrap.fading blockquote { opacity: 0; transform: translateY(8px); }
    .rstage blockquote strong { font-weight: 700; }
    .testi-attr {
      flex: 0 0 auto; margin-top: 28px; padding-top: 22px;
      border-top: 1px solid var(--rule); display: flex; align-items: center;
      gap: 16px; transition: opacity .35s ease;
    }
    .testi-attr.fading { opacity: 0; }
    .testi-avatar {
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--ink); color: var(--paper);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 13px; letter-spacing: .02em; flex-shrink: 0;
    }
    .testi-avatar-photo {
      width: 48px; height: 48px; border-radius: 50%;
      object-fit: cover; object-position: center top;
      filter: grayscale(1) contrast(1.1); flex-shrink: 0;
    }
    .testi-attr .t-name { font-size: 14px; font-weight: 700; line-height: 1.3; }
    .testi-attr .t-role { font-size: 12px; color: var(--mute-dark); margin-top: 2px; }
    .testi-controls {
      display: flex; flex-direction: column; gap: 24px;
      align-items: flex-end; align-self: end; padding-bottom: 4px;
      justify-content: flex-end;
    }
    .ctrl-pager { font-size: 11px; letter-spacing: .14em; color: var(--mute); text-transform: uppercase; font-weight: 500; }
    .ctrl-pager strong {
      color: var(--ink); font-weight: 800; font-size: 32px;
      letter-spacing: -.02em; display: inline-block; vertical-align: -2px; margin-right: 4px;
    }
    .testi-progress { width: 240px; height: 2px; background: var(--rule); overflow: hidden; }
    .testi-progress span {
      display: block; width: 100%; height: 100%; background: var(--ink);
      transform-origin: left; transition: transform .5s ease;
    }
    .ctrl-arrows { display: flex; gap: 12px; }
    .ctrl-arrow {
      width: 48px; height: 48px; border: 1px solid rgba(25,25,23,.18);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 16px; transition: all .2s;
      user-select: none; color: var(--ink); background: transparent; border: 1px solid rgba(25,25,23,.18);
    }
    .ctrl-arrow:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

    /* ── WHO AM I ──────────────────────────────────────────── */
    .aboutme { background: var(--paper); }
    .aboutme-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 80px; align-items: center; }
    .aboutme-photo { aspect-ratio: 4/5; overflow: hidden; background: var(--soft); }
    .aboutme-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
      filter: grayscale(1) contrast(1.02);
    }
    .aboutme h2 {
      font-weight: 800; font-size: clamp(45px, 4.8vw, 70px);
      line-height: .96; letter-spacing: -.04em;
      margin: 24px 0 32px; text-transform: uppercase;
    }
    .aboutme p { font-size: 17px; line-height: 1.65; margin: 0 0 18px; max-width: 520px; }
    .aboutme p :global(strong) { font-weight: 700; }
    .aboutme .mute { color: var(--mute-dark); }
/* ── ACCREDITATIONS ───────────────────────────────────── */
    .accreds {
      margin-top: 80px;
      padding-top: 56px;
      border-top: 1px solid var(--rule);
    }
    .accreds-head {
      display: flex; align-items: baseline; justify-content: center;
      margin: 0 0 48px; gap: 24px;
    }
    .accreds-head h3 {
      font-weight: 600; font-size: 13px; line-height: 1;
      letter-spacing: .22em; margin: 0; text-transform: uppercase;
      color: var(--mute-dark);
    }
    .accreds-row {
      display: flex; flex-wrap: wrap; justify-content: center;
    }
    .accred {
      flex: 0 0 20%; padding: 8px 24px 4px;
      border-left: 1px solid var(--rule);
      display: flex; flex-direction: column; align-items: center;
      text-align: center; gap: 18px;
    }
    /* Remove left border for first item of each row of 5 */
    .accred:nth-child(5n+1) { border-left: 0; }
    .accred .mark {
      width: 84px; height: 84px; border: 1px solid var(--ink);
      border-radius: 50%; display: flex; align-items: center;
      justify-content: center; font-weight: 800; letter-spacing: -.02em;
      color: var(--ink); background: var(--paper);
      transition: background .2s, color .2s; flex-shrink: 0;
      font-size: 19px;
    }
    .accred .mark.size-l { font-size: 22px; }
    .accred .mark.size-m { font-size: 19px; }
    .accred .mark.size-s { font-size: 15px; letter-spacing: -.01em; }
    .accred .mark-photo {
      width: 84px; height: 84px; border-radius: 50%;
      object-fit: contain; border: 1px solid var(--rule);
      background: var(--paper); flex-shrink: 0;
      filter: grayscale(1);
      transition: opacity .2s;
    }
    .accred:hover .mark { background: var(--ink); color: var(--paper); }
    .accred:hover .mark-photo { opacity: .75; }
    .accred .body {
      display: flex; flex-direction: column; gap: 8px;
      align-items: center; min-height: 84px;
    }
    .accred .aname {
      font-size: 13px; font-weight: 700; line-height: 1.3;
      letter-spacing: -.005em; text-transform: uppercase;
      color: var(--ink); max-width: 180px;
    }
    .accred .issuer {
      font-size: 10.5px; color: var(--mute-dark); letter-spacing: .14em;
      text-transform: uppercase; font-weight: 500; line-height: 1.4; max-width: 180px;
    }
    @media (max-width: 1000px) {
      .accreds { margin-top: 56px; padding-top: 40px; }
      .accreds-head { margin-bottom: 32px; }
      .accreds-row { grid-template-columns: repeat(2, 1fr); gap: 32px 0; }
      .accred { border-left: 0; padding: 16px 12px; }
      .accred:nth-child(even) { border-left: 1px solid var(--rule); }
    }

    /* ── CONTACT ───────────────────────────────────────────── */
    .contact { background: var(--ink); color: var(--paper); padding: 140px 0 0; }
    .contact .head h2 {
      font-weight: 400; font-size: 56px; line-height: 1.05;
      letter-spacing: -.02em; margin: 16px 0 64px; max-width: 720px;
    }
    .contact .head h2 strong { font-weight: 800; }
    .contact-grid {
      display: grid; grid-template-columns: 1.1fr 1.4fr;
      gap: 80px; align-items: start; padding-bottom: 100px;
    }
    .contact-left p {
      font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.75);
      max-width: 380px; margin: 0 0 32px;
    }
    .contact-creds {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px 32px; padding-top: 28px;
      border-top: 1px solid var(--rule-dark); max-width: 520px;
    }
    .contact-creds div .lbl {
      font-size: 11px; color: rgba(255,255,255,.5); letter-spacing: .12em;
      text-transform: uppercase; margin-bottom: 6px; font-weight: 500;
    }
    .contact-creds div .val { font-size: 14px; font-weight: 700; }
    .form { display: flex; flex-direction: column; gap: 22px; }
    .form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .field { display: flex; flex-direction: column; gap: 8px; }
    .field label {
      font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.5); font-weight: 500;
    }
    .field input, .field textarea {
      background: transparent; border: 0;
      border-bottom: 1px solid rgba(255,255,255,.25);
      padding: 8px 0 12px; color: var(--paper);
      font-family: inherit; font-size: 17px; outline: none;
      transition: border-color .2s;
    }
    .field input:focus, .field textarea:focus { border-color: var(--paper); }
    .field textarea { resize: vertical; min-height: 60px; }
    .submit {
      background: var(--paper); color: var(--ink); border: 0;
      padding: 18px 28px; font-weight: 700; font-size: 13px;
      letter-spacing: .1em; text-transform: uppercase; font-family: inherit;
      cursor: pointer; transition: all .15s; align-self: flex-start; margin-top: 12px;
    }
    .submit:hover { background: var(--soft); }
    .submitted-msg { padding: 40px 0; }
    .submitted-msg .msg-card {
      display: inline-flex; flex-direction: column; gap: 18px;
      padding: 28px 32px; max-width: 400px;
      border: 1px solid rgba(255,255,255,.13);
      background: rgba(255,255,255,.04);
    }
    .submitted-msg .msg-icon {
      width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,.22);
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; color: rgba(255,255,255,.6);
    }
    .submitted-msg .recv {
      font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(255,255,255,.38); font-weight: 500;
    }
    .submitted-msg .thanks {
      font-weight: 300; font-size: 21px; letter-spacing: -.01em;
      line-height: 1.45; color: rgba(255,255,255,.88);
    }
    .submitted-msg .thanks strong { font-weight: 700; color: #fff; }

    /* ── FOOTER ────────────────────────────────────────────── */
    .foot-mark { color: var(--paper); padding: 64px 48px 0; }
    .foot-mark .big {
      font-weight: 800; font-size: clamp(32px, 5.5vw, 80px);
      letter-spacing: -.045em; line-height: .9; white-space: nowrap;
    }
    .foot-meta {
      color: rgba(255,255,255,.5);
      padding: 24px 48px 32px;
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12px;
      border-top: 1px solid var(--rule-dark); margin: 24px 48px 0;
    }

    .mobile-cta { display: none; }

    /* ── LANGUAGE SWITCHER ─────────────────────────────────── */
    .lang-switch { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; letter-spacing: .08em; }
    .lang-switch .lang { color: rgba(255,255,255,.45); text-decoration: none; transition: color .2s; }
    .lang-switch .lang.active { color: var(--paper); }
    .lang-switch .lang:hover { color: var(--paper); }
    .lang-switch .lang-sep { color: rgba(255,255,255,.25); }

    /* ── RESPONSIVE ────────────────────────────────────────────
       Tablet  ≤ 1024px
       Mobile  ≤  680px
    ───────────────────────────────────────────────────────── */

    /* — Tablet — */
    @media (max-width: 1024px) {
      .container { padding: 0 40px; }
      .nav-inner { padding: 16px 40px; }
      section { padding: 100px 0; }
      .contact { padding-top: 100px; }

      /* The How */
      .what-block { grid-template-columns: 1fr 1.4fr; gap: 48px; }

      /* Services */
      .service { grid-template-columns: 72px 1.2fr 1fr; gap: 32px; }

      /* Testimonials: keep 2-col but tighter */
      .testi { padding: 28px; }
      .testi blockquote { font-size: 14px; }

      /* Who am I */
      .aboutme-grid { grid-template-columns: 1fr 1.2fr; gap: 48px; }

      /* Accreditations: 3 per row on tablet */
      .accred { flex: 0 0 33.333%; }
      .accred:nth-child(5n+1) { border-left: 1px solid var(--rule); }
      .accred:nth-child(3n+1) { border-left: 0; }

      /* Contact */
      .contact-grid { gap: 56px; }
      .contact .head h2 { font-size: 44px; }

      /* Footer */
      .foot-mark { padding: 56px 40px 20px; }
      .foot-meta { margin: 20px 40px 0; padding: 20px 0 28px; }
    }

    /* — Mobile — */
    @media (max-width: 680px) {
      .container { padding: 0 20px; }
      .nav-inner { padding: 14px 20px; }
      .nav-links { display: none; }
      .nav-brand { display: block; } /* show name on mobile */
      section { padding: 72px 0; }
      .contact { padding-top: 72px; }

      /* The How */
      .what-block { grid-template-columns: 1fr; gap: 28px; }
      .what-block .left p:empty { display: none; } /* block1 may be empty — hide blank p */
      .what-block .right h2 { font-size: clamp(22px, 5.6vw, 35px); }

      /* Questions */
      .q-head { flex-direction: column; align-items: flex-start; gap: 12px; }
      .q-head h3 { font-size: 19px; }
      .q-stage { padding-left: 24px; height: calc(4 * 0.98 * 56px + 40px); }
      .q-text { font-size: clamp(36px, 9vw, 56px); }
      .q-bullet { top: 20px; }

      /* Services */
      .services-head { grid-template-columns: 1fr; gap: 12px; }
      .services-head .ix { display: none; }
      .services-head h2 { font-size: 36px; }
      .service { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
      .service .sno { font-size: 11px; letter-spacing: .1em; color: rgba(255,255,255,.4); }
      .service .stitle { font-size: 22px; }
      .service ul { columns: 1; }

      /* Testimonials rotator — mobile */
      .testimonials { padding: 64px 0 72px; }
      .testi-head h2 { font-size: 36px; }
      .testi-rotator { grid-template-columns: 1fr; gap: 24px; height: auto; }
      .rstage { height: 260px; }
      .rstage blockquote { font-size: 13px; }
      .testi-controls { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
      .testi-progress { display: none; }

      /* Who am I */
      .aboutme-grid { grid-template-columns: 1fr; gap: 0; }
      .aboutme-photo {
        aspect-ratio: 3/2; margin: -72px -20px 0; /* bleed to edges */
        mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
      }
      .aboutme h2 { font-size: clamp(36px, 9vw, 56px); margin: 20px 0 24px; }
      .aboutme p { font-size: 16px; }

/* Accreditations: 2 per row on mobile */
      .accred { flex: 0 0 50%; padding: 12px 8px; }
      .accred:nth-child(5n+1), .accred:nth-child(3n+1) { border-left: 1px solid var(--rule); }
      .accred:nth-child(odd) { border-left: 0; }
      .accred:nth-child(even) { border-left: 1px solid var(--rule); }
      .accred .mark { width: 72px; height: 72px; }

      /* Contact */
      .contact .head h2 { font-size: 32px; line-height: 1.1; }
      .contact-grid { grid-template-columns: 1fr; gap: 40px; }
      .contact-creds { grid-template-columns: 1fr 1fr; }
      .form .row { grid-template-columns: 1fr; }

      /* Footer */
      .foot-mark { padding: 48px 20px 16px; }
      .foot-meta {
        margin: 16px 20px 0; padding: 16px 0 28px;
        flex-direction: column; gap: 8px; text-align: center;
      }
      .foot-meta span { display: flex; gap: 16px; align-items: center; justify-content: center; flex-wrap: wrap; }

      /* Pull quote */
      .pull blockquote { font-size: 32px; }
    }

    /* ── MOBILE HERO V2 (Bottom Veil) ─────────────────────────── */
    /* These are default-hidden desktop overrides for new mobile elements */
    .hero-mobile-veil,
    .hero-mobile-header,
    .hero-mobile-cta-pill,
    .mobile-nav-overlay { display: none; }

    .hamburger-btn {
      width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,.32); background: transparent;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; padding: 0; flex-shrink: 0;
    }

    /* Mobile nav overlay */
    .mobile-nav-overlay {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(10,9,7,.97);
      flex-direction: column;
      padding: 56px 24px calc(40px + env(safe-area-inset-bottom));
      transform: translateY(-100%);
      transition: transform .32s cubic-bezier(.4,0,.2,1);
    }
    .mobile-nav-overlay.open {
      display: flex;
      transform: translateY(0);
    }
    .mobile-nav-top {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 56px;
    }
    .mobile-nav-close {
      width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,.25); background: transparent;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; padding: 0;
    }
    .mobile-nav-links {
      display: flex; flex-direction: column; gap: 0; flex: 1;
    }
    .mobile-nav-links a {
      font-size: 32px; font-weight: 700; letter-spacing: -.02em;
      color: rgba(255,255,255,.85); text-decoration: none; line-height: 1;
      padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,.08);
      transition: color .15s;
    }
    .mobile-nav-links a:first-child { border-top: 1px solid rgba(255,255,255,.08); }
    .mobile-nav-links a:hover { color: #fff; }
    .mobile-nav-book {
      display: block; margin-top: 40px; padding: 16px 20px;
      border: 1px solid rgba(255,255,255,.4); border-radius: 999px;
      text-align: center; color: #fff; text-decoration: none;
      font-size: 15px; font-weight: 500; letter-spacing: .005em;
      font-family: "Archivo", "Manrope", sans-serif;
      transition: background .15s;
    }
    .mobile-nav-book:hover { background: rgba(255,255,255,.08); }

    @media (max-width: 680px) {
      /* ── Hero container ── */
      .hero {
        --photo-h: clamp(380px, 52vh, 520px);
        background: #0a0907;
        aspect-ratio: unset;
        min-height: 100svh; min-height: 100vh;
      }

      /* ── Photo band ── */
      .hero-photo {
        position: absolute; top: 0; left: 0; right: 0;
        height: var(--photo-h);
        overflow: hidden;
      }
      .hero-photo img {
        object-position: center 30%;
        filter: grayscale(1) contrast(1.04) brightness(0.98);
      }

      /* ── Existing hero-grad becomes the TOP veil only ── */
      .hero-grad {
        position: absolute; top: 0; left: 0; right: 0;
        height: 150px; bottom: unset;
        background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 100%);
      }

      /* ── Bottom veil (photo → dark bg, new element) ── */
      .hero-mobile-veil {
        display: block;
        position: absolute; left: 0; right: 0;
        top: calc(var(--photo-h) - 120px);
        height: 120px;
        background: linear-gradient(180deg, rgba(10,9,7,0) 0%, rgba(10,9,7,.85) 70%, rgba(10,9,7,1) 100%);
        pointer-events: none;
      }

      /* ── Hide desktop hero nav ── */
      .hero-nav { display: none; }

      /* ── Mobile header ── */
      .hero-mobile-header {
        display: flex; justify-content: space-between; align-items: center;
        position: absolute; top: 0; left: 0; right: 0; z-index: 30;
        padding: 52px 20px 0;
      }
      /* Override nav-brand-block colours for dark bg */
      .hero-mobile-header .nav-brand-name { font-family: "Archivo", "Manrope", sans-serif; font-size: 11px; letter-spacing: .11em; }
      .hero-mobile-header .nav-brand-sub  { font-family: "Archivo", "Manrope", sans-serif; font-size: 11px; letter-spacing: .11em; }

      /* ── Name lockup ── */
      .hero-stack {
        position: absolute;
        top: calc(var(--photo-h) - 30px);
        left: 20px; right: 20px;
        bottom: unset;
        text-align: left;
        padding: 0;
        z-index: 2;
      }
      .hero-name {
        font-family: "Archivo Black", "Manrope", sans-serif;
        font-size: 60px;
        line-height: .92;
        letter-spacing: -.025em;
        color: #fff;
        margin: 0;
      }

      /* ── Tagline — flows inside hero-stack, not absolute ── */
      .hero-tagline {
        position: static;
        margin: 20px 0 0;
        font-family: "Archivo", "Manrope", sans-serif;
        font-size: 15px;
        line-height: 1.38;
        letter-spacing: -.005em;
        color: rgba(255,255,255,.78);
        padding: 0;
        text-align: left;
      }
      /* Strong tags inside tagline (from boldMd) */
      .hero-tagline :global(strong) { font-weight: 700; color: rgba(255,255,255,.78); }

      /* ── Mobile CTA pill ── */
      .hero-mobile-cta-pill {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        position: absolute; left: 20px; right: 20px;
        bottom: calc(40px + env(safe-area-inset-bottom));
        padding: 14px 20px; border-radius: 999px;
        border: 1px solid rgba(255,255,255,.45);
        background: transparent;
        font-family: "Archivo", "Manrope", sans-serif;
        font-size: 13px; font-weight: 500; letter-spacing: .005em;
        color: #fff; text-decoration: none;
        transition: background .15s;
        z-index: 2;
      }
      .hero-mobile-cta-pill:hover { background: rgba(255,255,255,.08); }
      .hero-mobile-cta-pill:active { background: rgba(255,255,255,.16); }

      /* Hide mobile elements that aren't the hero on mobile
         (the .mobile-cta floating pill from old code, if still present) */
      .mobile-cta { display: none !important; }
    }

    /* ── LANDSCAPE MOBILE ──────────────────────────────────── */
    @media (orientation: landscape) and (max-width: 1023px) {
      /* Hero: shorter, name smaller, tighter stack */
      .hero { min-height: 100svh; min-height: 100vh; aspect-ratio: unset; }
      .hero-stack { bottom: 28px; padding: 0 28px; }
      .hero-name { font-size: clamp(52px, 9vw, 80px); margin-bottom: 10px; }
      .hero-tagline { font-size: clamp(17px, 2.4vw, 26px); padding: 0 20px; }
      .hero-nav { display: none; }

      /* Sections: tighter padding */
      section { padding: 56px 0; }
      .container { padding: 0 28px; }
      .nav-inner { padding: 12px 28px; }
      .nav-brand { display: block; }
      .nav-links { display: none; }

      /* The How: single column */
      .what-block { grid-template-columns: 1fr; gap: 24px; }
      .what-block .left p:empty { display: none; }
      .what-block .right h2 { font-size: clamp(19px, 4vh, 29px); }

      /* Questions */
      .q-head { flex-direction: column; align-items: flex-start; gap: 10px; }
      .q-stage { height: calc(3 * 0.98 * 38px + 32px); }
      .q-text { font-size: clamp(28px, 5.6vh, 38px); }

      /* Services */
      .services-head { grid-template-columns: 1fr; gap: 12px; }
      .services-head .ix { display: none; }
      .service { grid-template-columns: 1fr; gap: 8px; padding: 20px 0; }
      .service ul { columns: 1; }

      /* Testimonials rotator — landscape */
      .testimonials { padding: 48px 0 56px; }
      .testi-rotator { grid-template-columns: 1fr 180px; gap: 40px; height: 260px; }
      .rstage blockquote { font-size: 13px; }

      /* Who I am */
      .aboutme-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
      .aboutme h2 { font-size: clamp(28px, 5.6vh, 38px); }
      .aboutme p { font-size: 15px; }

      /* Accreditations */
      .accred { flex: 0 0 20%; }

      /* Contact */
      .contact-grid { grid-template-columns: 1fr; gap: 32px; }
      .form .row { grid-template-columns: 1fr 1fr; }

      /* Footer */
      .foot-mark { padding: 40px 28px 12px; }
      .foot-meta { margin: 12px 28px 0; padding: 12px 0 24px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/de/" class="nav-brand-block">
        <span class="nav-brand-name">Jasmine Truong</span>
        <span class="nav-brand-sub">Executive Coaching</span>
      </a>
      <div class="nav-links">
        <a href="#the-how">Meine Arbeitsweise</a>
        <a href="#services">Angebote</a>
        <a href="#testimonials">Stimmen</a>
        <a href="#aboutme">Über mich</a>
      </div>
      <div style="display:flex; align-items:center; gap:20px; justify-self:end;">
        <a href={hero.cta_href} class="nav-cta">
          <span class="pill">{hero.cta_label_de}</span>
        </a>
        <div class="lang-switch">
          <a href="/" class="lang">EN</a>
          <span class="lang-sep">|</span>
          <span class="lang active">DE</span>
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile floating CTA (hidden on desktop via CSS) -->
  <a href="#contact" class="mobile-cta" style="display:none;">
    <span class="pill">{hero.cta_label_de}</span>
  </a>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-photo">
      <img src="/images/jasmine-serious.jpg" alt="Jasmine Truong" />
    </div>
    <div class="hero-grad"></div>

    <!-- Mobile photo bottom veil (hidden on desktop) -->
    <div class="hero-mobile-veil"></div>

    <!-- Mobile header: wordmark + lang + hamburger (hidden on desktop) -->
    <div class="hero-mobile-header">
      <a href="/de/" class="nav-brand-block">
        <span class="nav-brand-name">Jasmine Truong</span>
        <span class="nav-brand-sub">Executive Coaching</span>
      </a>
      <div style="display:flex; align-items:center; gap:14px;">
        <div class="lang-switch">
          <a href="/" class="lang">EN</a>
          <span class="lang-sep">|</span>
          <span class="lang active">DE</span>
        </div>
        <button class="hamburger-btn" id="hamburger-btn" aria-label="Menü öffnen">
          <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
            <line x1="0" y1="1.5" x2="15" y2="1.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="0" y1="9.5" x2="15" y2="9.5" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile CTA pill pinned to bottom of hero (hidden on desktop) -->
    <a href="#contact" class="hero-mobile-cta-pill">
      {hero.cta_label_de}
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
        <path d="M0 5h12M8 1l4 4-4 4" stroke="white" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <nav class="hero-nav">
      <a href="/de/" class="nav-brand-block">
        <span class="nav-brand-name">Jasmine Truong</span>
        <span class="nav-brand-sub">Executive Coaching</span>
      </a>
      <ul>
        <li><a href="#the-how">Meine Arbeitsweise</a></li>
        <li><a href="#services">Angebote</a></li>
        <li><a href="#testimonials">Stimmen</a></li>
        <li><a href="#aboutme">Über mich</a></li>
      </ul>
      <div style="display:flex; align-items:center; gap:16px; justify-self:end;">
        <a class="cta" href={hero.cta_href}>{hero.cta_label_de}</a>
        <div class="lang-switch">
          <a href="/" class="lang">EN</a>
          <span class="lang-sep">|</span>
          <span class="lang active">DE</span>
        </div>
      </div>
    </nav>

    <div class="hero-stack">
      <h1 class="hero-name">Jasmine Truong</h1>
      <p class="hero-tagline" set:html={boldMd(hero.tagline_de)}></p>
    </div>
  </section>

  <!-- Mobile nav overlay -->
  <div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true">
    <div class="mobile-nav-top">
      <a href="/de/" class="nav-brand-block">
        <span class="nav-brand-name">Jasmine Truong</span>
        <span class="nav-brand-sub">Executive Coaching</span>
      </a>
      <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Menü schließen">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <line x1="1" y1="1" x2="13" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="13" y1="1" x2="1" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-nav-links">
      <a href="#the-how">Meine Arbeitsweise</a>
      <a href="#services">Angebote</a>
      <a href="#testimonials">Stimmen</a>
      <a href="#aboutme">Über mich</a>
    </nav>
    <a href="#contact" class="mobile-nav-book" id="mobile-nav-book">Gespräch beginnen →</a>
  </div>

  <!-- THE HOW + QUESTIONS -->
  <section class="what-questions" id="the-how">
    <div class="container">

      <!-- The How -->
      <div class="what-block">
        <div class="left">
          <div class="label">{theHow.label_de}</div>
          <p set:html={boldMd(theHow.block1_de)}></p>
        </div>
        <div class="right">
          <h2 set:html={boldMd(theHow.block2_de)}></h2>
          <p set:html={boldMd(theHow.block3_de)}></p>
        </div>
      </div>

      <!-- Rotating Questions -->
      <div class="questions-merged" id="questions">
        <div class="q-head">
          <h3 set:html={boldMd(questionsSection.heading_de)}></h3>
          <div class="pager">
            <span class="count" id="q-count">01 / 04</span>
            <div class="progress"><span id="q-bar" style="transform: scaleX(0.25)"></span></div>
          </div>
        </div>

        <div class="q-stage q-fade-in" id="q-stage">
          <div class="q-bullet"></div>
          <p class="q-text" id="q-text">{questionsSection.questions_de[0]}</p>
        </div>

      </div>

    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="container">
      <div class="services-head">
        <div class="ix">04</div>
        <div>
          <h2>{servicesSection.heading_plain_de} <strong>{servicesSection.heading_bold_de}</strong></h2>
          <p class="lead">{servicesSection.lead_de}</p>
        </div>
      </div>

      {services.map((s: any, i: number) => (
        <div class="service">
          <div class="sno">/{String(i + 1).padStart(2, '0')}</div>
          <div>
            <div class="stitle">{s.data.title_de ?? s.data.title}</div>
            <div class="smeta">{s.data.tagline_de ?? s.data.tagline}</div>
          </div>
          <div>
            <p set:html={boldMd(s.data.description_de ?? s.data.description)}></p>
            {s.data.details && s.data.details.length > 0 && (
              <ul>
                {s.data.details.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials" id="testimonials">
    <div class="container">
      <div class="testi-head">
        <h2 set:html={boldMd(testimonialsSection.heading_de)}></h2>
        <span class="ix">/{String(testimonials.length).padStart(2,'0')}</span>
      </div>
      <div class="testi-rotator">
        <div class="rstage">
          <div class="qmark-big">"</div>
          <div class="quote-wrap" id="quote-wrap">
            <blockquote id="quote-text"></blockquote>
          </div>
          <div class="testi-attr" id="testi-attr">
            <div id="testi-avatar-wrap"></div>
            <div>
              <div class="t-name" id="testi-name"></div>
              <div class="t-role" id="testi-role"></div>
            </div>
          </div>
        </div>
        <div class="testi-controls">
          <div class="ctrl-pager">
            <strong id="pager-cur">01</strong> / <span id="pager-tot">{String(testimonials.length).padStart(2,'0')}</span>
          </div>
          <div class="testi-progress">
            <span id="testi-progress-bar"></span>
          </div>
          <div class="ctrl-arrows">
            <button class="ctrl-arrow" id="testi-prev" aria-label="Vorheriges">←</button>
            <button class="ctrl-arrow" id="testi-next" aria-label="Nächstes">→</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO AM I -->
  <section class="aboutme" id="aboutme">
    <div class="container">
      <div class="aboutme-grid">
        <div class="aboutme-photo">
          <img src="/images/jasmine-looking-up.jpg" alt="Jasmine Truong" />
        </div>
        <div>
          <h2>{aboutme_section.heading_de}</h2>
          <div set:html={bioParagraphs(aboutme_section.bio_de)}></div>
        </div>
      </div>
      <div class="accreds">
        <div class="accreds-head">
          <h3>{accredsSectionData.heading_de}</h3>
        </div>
        <div class="accreds-row">
          {accreditations.map((a: any) => (
            <div class="accred">
              {a.data.photo
                ? <img class="mark-photo" src={a.data.photo} alt={a.data.name} />
                : <div class={`mark ${a.data.initials.length <= 3 ? 'size-l' : a.data.initials.length === 4 ? 'size-m' : 'size-s'}`}>{a.data.initials}</div>
              }
              <div class="body">
                <div class="aname">{a.data.name}</div>
                <div class="issuer">{a.data.issuer}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact" style="padding:140px 0 0;">
    <div class="container">
      <div class="head">
        <h2>{contact_section.heading_plain_de} <strong>{contact_section.heading_bold_de}</strong></h2>
      </div>
      <div class="contact-grid">
        <div class="contact-left">
          <p set:html={boldMd(contact_section.intro_de)}></p>
          <div class="contact-creds">
            <div>
              <div class="lbl">{contact_section.detail_location_label_de}</div>
              <div class="val">{contact_section.detail_location_value}</div>
            </div>
            <div>
              <div class="lbl">{contact_section.detail_format_label_de}</div>
              <div class="val">{contact_section.detail_format_value_de}</div>
            </div>
            <div>
              <div class="lbl">{contact_section.detail_languages_label_de}</div>
              <div class="val">{contact_section.detail_languages_value}</div>
            </div>
          </div>
        </div>
        <div>
          <div id="form-wrap">
            <form class="form" id="contact-form" name="contact-de" method="POST" data-netlify="true">
              <input type="hidden" name="form-name" value="contact-de" />
              <div class="row">
                <div class="field">
                  <label for="name">Name</label>
                  <input id="name" name="name" type="text" required placeholder="Dein Name" />
                </div>
                <div class="field">
                  <label for="email">E-Mail</label>
                  <input id="email" name="email" type="email" required placeholder="du@beispiel.com" />
                </div>
              </div>
              <div class="row">
                <div class="field">
                  <label for="role">Rolle</label>
                  <input id="role" name="role" type="text" placeholder="CEO, COO, VP…" />
                </div>
                <div class="field">
                  <label for="org">Organisation</label>
                  <input id="org" name="organization" type="text" placeholder="Unternehmen" />
                </div>
              </div>
              <div class="field">
                <label for="message">Was bringt dich hierher?</label>
                <textarea id="message" name="message" required placeholder="Ein oder zwei Sätze genügen."></textarea>
              </div>
              <button type="submit" class="submit">Gespräch beginnen →</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="background:var(--ink);">
    <div class="foot-mark">
      <div class="big">{footerData.wordmark}</div>
    </div>
    <div class="foot-meta">
      <span>{footerData.copyright_de}</span>
      <span style="display:flex; gap:24px; align-items:center;">
        <a href="/privacy" style="color:inherit; text-decoration:none; opacity:.7;">Datenschutz</a>
        <span>{footerData.tagline_de}</span>
      </span>
    </div>
  </footer>

  <!-- JS: rotating questions + form -->
  <script define:vars={{ questionsData: questionsSection.questions_de, formSuccessLabel: contact_section.form_success_label_de, formSuccessThanks: contact_section.form_success_thanks_de, testiData: testimonials.map((t: any) => ({ quote: t.data.quote, name: t.data.name, role: [t.data.position, t.data.company].filter(Boolean).join(', '), initials: t.data.name.split(' ').map((w: string) => w[0]).join(''), photo: t.data.photo || null })) }}>
    // ── Sticky nav — show after hero ───────────────────────
    const stickyNav = document.querySelector('.nav');
    const hero = document.querySelector('.hero');
    function onScroll() {
      const heroBottom = hero.getBoundingClientRect().bottom;
      stickyNav.classList.toggle('visible', heroBottom <= 0);
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    // ── Mobile nav (hamburger) ────────────────────────────────
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileNavOverlay = document.getElementById('mobile-nav-overlay');
    const mobileNavClose = document.getElementById('mobile-nav-close');
    const mobileNavBook = document.getElementById('mobile-nav-book');

    function openMobileNav() {
      mobileNavOverlay.classList.add('open');
      mobileNavOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeMobileNav() {
      mobileNavOverlay.classList.remove('open');
      mobileNavOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (hamburgerBtn) hamburgerBtn.addEventListener('click', openMobileNav);
    if (mobileNavClose) mobileNavClose.addEventListener('click', closeMobileNav);
    if (mobileNavBook) mobileNavBook.addEventListener('click', closeMobileNav);
    // Close on nav link click
    if (mobileNavOverlay) {
      mobileNavOverlay.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', closeMobileNav);
      });
    }

    // ── Rotating questions (injected from CMS data) ────────
    const questions = questionsData;

    let qIdx = 0;
    let transitioning = false;

    const stage   = document.getElementById('q-stage');
    const qText   = document.getElementById('q-text');
    const qCount  = document.getElementById('q-count');
    const qBar    = document.getElementById('q-bar');

    function updatePager(idx) {
      qCount.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(questions.length).padStart(2, '0');
      qBar.style.transform = 'scaleX(' + ((idx + 1) / questions.length) + ')';
    }

    function advance() {
      if (transitioning) return;
      transitioning = true;
      stage.classList.remove('q-fade-in');
      stage.classList.add('q-fade-out');
      setTimeout(() => {
        qIdx = (qIdx + 1) % questions.length;
        qText.textContent = questions[qIdx];
        updatePager(qIdx);
        stage.classList.remove('q-fade-out');
        stage.classList.add('q-fade-in');
        transitioning = false;
      }, 380);
    }

    updatePager(0);
    setInterval(advance, 6800);

    // ── Testimonials rotator ─────────────────────────────────
    function boldMdJS(text) {
      return (text || '').replace(/\*\*(.*?)\*\*/gs, '<strong>$1</strong>').replace(/\*(.*?)\*/gs, '<em>$1</em>');
    }

    const TESTI = testiData;
    const TESTI_FADE = 350;
    const TESTI_AUTO = 6500;
    let tIdx = 0;
    let tTimer;

    const elQuoteWrap  = document.getElementById('quote-wrap');
    const elQuote      = document.getElementById('quote-text');
    const elTAttr      = document.getElementById('testi-attr');
    const elAvatarWrap = document.getElementById('testi-avatar-wrap');
    const elTName      = document.getElementById('testi-name');
    const elTRole      = document.getElementById('testi-role');
    const elPagerCur   = document.getElementById('pager-cur');
    const elTProgress  = document.getElementById('testi-progress-bar');

    function renderTesti() {
      const t = TESTI[tIdx];
      elQuote.innerHTML = boldMdJS(t.quote);
      elAvatarWrap.innerHTML = t.photo
        ? `<img src="${t.photo}" alt="${t.name}" style="width:48px;height:48px;border-radius:50%;object-fit:cover;object-position:center top;filter:grayscale(1) contrast(1.1);flex-shrink:0;">`
        : `<div style="width:48px;height:48px;border-radius:50%;background:#191917;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;letter-spacing:.02em;flex-shrink:0;">${t.initials}</div>`;
      elTName.textContent = t.name;
      elTRole.textContent = t.role;
      elPagerCur.textContent = String(tIdx + 1).padStart(2, '0');
      if (elTProgress) elTProgress.style.transform = `scaleX(${(tIdx + 1) / TESTI.length})`;
    }

    function changeTesti(delta) {
      elQuoteWrap.classList.add('fading');
      elTAttr.classList.add('fading');
      setTimeout(() => {
        tIdx = (tIdx + delta + TESTI.length) % TESTI.length;
        renderTesti();
        elQuoteWrap.classList.remove('fading');
        elTAttr.classList.remove('fading');
      }, TESTI_FADE);
    }

    function startTestiAutoplay() {
      clearInterval(tTimer);
      tTimer = setInterval(() => changeTesti(1), TESTI_AUTO);
    }

    const btnNext = document.getElementById('testi-next');
    const btnPrev = document.getElementById('testi-prev');
    if (btnNext) btnNext.addEventListener('click', () => { changeTesti(1);  startTestiAutoplay(); });
    if (btnPrev) btnPrev.addEventListener('click', () => { changeTesti(-1); startTestiAutoplay(); });

    renderTesti();
    startTestiAutoplay();

    // ── Contact form ────────────────────────────────────────
    const form = document.getElementById('contact-form');
    const wrap = document.getElementById('form-wrap');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const params = new URLSearchParams(new FormData(form)).toString();
        try {
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params,
          });
        } catch (_) {}
        wrap.innerHTML = `
          <div class="submitted-msg">
            <div class="msg-card">
              <div class="msg-icon">✓</div>
              <div class="recv">${formSuccessLabel}</div>
              <div class="thanks">${formSuccessThanks}</div>
            </div>
          </div>`;
      });
    }
  </script>

</body>
</html>
