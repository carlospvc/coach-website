---
import Layout from '../layouts/Layout.astro';
import siteData from '../content/site/main.json';

const { about, contact } = siteData;
---

<Layout title="About — Business Coach" description={about.body.slice(0, 160)}>

  <section class="max-w-3xl mx-auto px-6 pt-20 pb-24">

    <div class="flex flex-col md:flex-row gap-10 items-start mb-16">
      <div class="w-36 h-36 rounded-2xl bg-neutral-100 flex-shrink-0 overflow-hidden">
        <div class="w-full h-full flex items-center justify-center text-5xl text-neutral-300">👤</div>
      </div>
      <div>
        <h1 class="text-4xl font-bold text-neutral-900 mb-3">{about.heading}</h1>
        <p class="text-lg text-neutral-500 leading-relaxed">{about.body.split('\n')[0]}</p>
      </div>
    </div>

    <div class="mb-16">
      {about.body.split('\n\n').map(para => (
        <p class="text-neutral-600 leading-relaxed mb-5">{para}</p>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-8 mb-16">
      <h2 class="font-semibold text-neutral-900 mb-4">Credentials & training</h2>
      <ul class="space-y-2 text-sm text-neutral-700">
        <li>✓ PCC — Professional Certified Coach, ICF</li>
        <li>✓ [Coaching school / programme name]</li>
        <li>✓ [Relevant certification or methodology]</li>
        <li>✓ [Years of experience / hours logged]</li>
      </ul>
    </div>

    <div class="text-center">
      <p class="text-neutral-500 mb-6">Want to explore working together?</p>
      <a
        href="/contact"
        class="inline-block px-7 py-3 rounded-xl font-semibold text-white hover:opacity-90 transition-opacity"
        style="background: var(--color-brand)"
      >
        Get in touch
      </a>
    </div>

  </section>
</Layout>
